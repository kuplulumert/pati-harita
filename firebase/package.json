{
  "name": "patiharita-firebase",
  "private": true,
  "description": "Firestore kuralları, indeksler ve testleri (emülatörde çalışır).",
  "scripts": {
    "emulators": "firebase emulators:start --project demo-patiharita",
    "test": "firebase emulators:exec --only firestore --project demo-patiharita \"vitest run\"",
    "deploy:rules": "firebase deploy --only firestore",
    "deploy:functions": "firebase deploy --only functions"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.30.2",
    "geofire-common": "^6.0.0",
    "vitest": "^5.0.1"
  }
}
